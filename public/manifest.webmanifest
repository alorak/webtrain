{
  "id": "./",
  "name": "WebTrain — Küçük bir dünya kur",
  "short_name": "WebTrain",
  "description": "Raylarını döşe, dünyanı süsle ve trenini yola çıkar.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#a9c986",
